# 复制为 .env 并填写真实值（.env 不进仓库）
# 微信后台 Token（须与微信公众平台配置一致，不可随意更换）
WECHAT_TOKEN=your-wechat-token-here
# 管理后台密码（逗号分隔可配多个，! 不分全半角）
ADMIN_PASSWORD=change-me
# 信任代理头（CF Tunnel/反代部署填 1，直连保持 0）
TRUST_PROXY_HEADERS=0
# 微信群入口微信号（显示在群类回复中，可在后台 💬 回复设置里随时改）
GROUP_WECHAT_ID=
# 兑换网站地址
WEBSITE_URL=https://example.com
