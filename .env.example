# 配置文件模板（.env 不进仓库）
# 💡 提示：所有项均可留空！系统支持【先运行项目，再在网页端配置】。
# 若在此填写，则环境变量具有最高优先级（覆盖网页端配置）。

# 微信后台 Token（与微信公众号平台「基本配置-服务器配置」填写的 Token 保持一致）
# 可留空：留空时启动后可在网页管理后台总览中直接填写保存
WECHAT_TOKEN=

# 管理后台管理员登录密码（逗号分隔可配多个）
# 可留空：留空时启动后浏览器访问 /admin 会自动进入【首次初始化向导】设置密码
ADMIN_PASSWORD=

# 信任代理头（CF Tunnel / Nginx 反向代理部署填 1，本地开发/直连保持 0）
TRUST_PROXY_HEADERS=0

# 微信群入口微信号（显示在群回复中，亦可在后台随时修改）
GROUP_WECHAT_ID=

# 兑换网站地址（回复模板中 {site} 占位符，亦可在后台随时修改）
WEBSITE_URL=https://example.com

# SQLite 数据库文件路径（本地开发可用 ./data/wechat_redeem.db，容器部署保持默认 /data/wechat_redeem.db）
DB_PATH=/data/wechat_redeem.db
